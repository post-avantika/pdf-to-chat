# =============================================================================
# .env.example — SAFE TO COMMIT. Contains fake placeholder values.
# Copy this to .env and fill in your real values.
#
#   cp .env.example .env
#   nano .env        # or open in your editor
# =============================================================================

# -----------------------------------------------------------------------------
# DOCKER COMPOSE — used by docker-compose.yml
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=pdf-chat
# ↑ Namespaces all Docker resources for this project (containers, volumes, networks).
#   If you run multiple build-paths projects, each needs a unique name here
#   to avoid collisions.

ORACLE_PWD=replace_me_with_a_strong_password_12chars_mixed
# ↑ Password for Oracle's built-in admin users: SYSTEM, SYS, PDBADMIN.
#   Rules: 12+ chars, mixed case, at least one digit, NO $ @ " symbols.
#   Generate one: python3 -c "import secrets,string; print('Or'+''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(18)))"

ORACLE_PORT=1521
# ↑ Port on YOUR LAPTOP that Oracle listens on.
#   Change this if something else is already using 1521 (rare on most laptops).

ORACLE_EM_PORT=5500
# ↑ Port for Oracle Enterprise Manager Express (browser-based admin panel).
#   Access at https://localhost:5500/em after Oracle starts.

ORACLE_VOLUME=pdf-chat-oracle-data
# ↑ Name of the Docker volume that persists Oracle's data files.
#   If you delete this volume ("docker volume rm pdf-chat-oracle-data"),
#   your database is gone. Treat it like a hard drive.

# -----------------------------------------------------------------------------
# DATABASE — used by Python code (oracledb + langchain-oracledb)
# -----------------------------------------------------------------------------
SYS_USER=SYSTEM
# ↑ Admin user — used ONLY during setup to create the app user (PDF_CHAT).
#   After setup, Python never connects as SYSTEM again.

SYS_PASSWORD=replace_me_with_a_strong_password_12chars_mixed
# ↑ Same password as ORACLE_PWD — Oracle uses one password for all admin users.

DB_USER=PDF_CHAT
# ↑ The application-level Oracle user. Has limited privileges — can only
#   access the tables our app creates. This is a security best practice:
#   never connect as SYSTEM in production code.

DB_PASSWORD=replace_me_with_a_different_app_user_password
# ↑ Password for the PDF_CHAT Oracle user (different from ORACLE_PWD).

DB_DSN=localhost:1521/FREEPDB1
# ↑ The "Data Source Name" — tells Python where Oracle lives.
#   Format: host:port/service_name
#   FREEPDB1 = Oracle's default pluggable database name in the Free edition.
#   If you changed ORACLE_PORT above, update the 1521 here too.

# -----------------------------------------------------------------------------
# LLM — Groq API (replaces the default OCI GenAI setting)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_replace_me_with_your_groq_key
# ↑ Your Groq API key from https://console.groq.com/keys
#   Starts with "gsk_". Free tier available. Never commit this.

LLM_BASE_URL=https://api.groq.com/openai
# ↑ Groq's OpenAI-compatible API endpoint.
#   The OpenAI Python client appends "/v1" automatically, so don't add it here.

LLM_MODEL=llama-3.3-70b-versatile
# ↑ The Groq model to use. Other options:
#   llama-3.1-8b-instant    (faster, smaller)
#   mixtral-8x7b-32768      (longer context window)
#   llama-3.3-70b-versatile (best quality on free tier ← we use this)

# -----------------------------------------------------------------------------
# EMBEDDINGS — runs locally in Python (no API call)
# -----------------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ↑ The HuggingFace model used to convert text → vectors.
#   Downloaded once (~90 MB) to ~/.cache/huggingface/ on first run.
#   384 dimensions. Free, local, no API key needed.
#   DO NOT change this mid-project — different models produce different
#   vector spaces and existing stored embeddings will become incompatible.
